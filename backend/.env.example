# Copy to .env. Keep secrets out of GitHub.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/REPLACE_WITH_INFURA_PROJECT_ID
CONTRACT_ADDRESS=0x1d355800fFA522d654cFd5186B6eE213aA292e75
CHAIN_ID=11155111
# Leave -1 to auto-detect the contract creation block via eth_getCode binary search.
CONTRACT_DEPLOYMENT_BLOCK=-1
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
SESSION_TTL_MINUTES=30
APP_DOMAIN=localhost:3000
CORS_ORIGINS=http://localhost:3000
DATABASE_PATH=./data/veridegree.sqlite3
EVENT_POLL_SECONDS=5
EVENT_BLOCK_STEP=500
EVENT_CONFIRMATIONS=3
EVENT_REORG_CHECKPOINTS=128
MAX_UPLOAD_MB=12
