# Sepolia RPC provider URL (Alchemy, Infura, or another provider)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_API_KEY

# Test-only deployer key. Never use a wallet holding real funds.
PRIVATE_KEY=0xYOUR_TEST_PRIVATE_KEY

# Three distinct, non-zero admin wallets
ADMIN_A=0x0000000000000000000000000000000000000001
ADMIN_B=0x0000000000000000000000000000000000000002
ADMIN_C=0x0000000000000000000000000000000000000003

# Etherscan API key for Sepolia contract verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Set this after deployment when running npm run verify:sepolia
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS
