    "hash:certificate": "node scripts/hash-certificate.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2"
  }
}
